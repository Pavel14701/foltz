# Настройки окружения Django-проекта «Фольц».
# Скопируйте в .env и заполните реальные значения: cp .env.example .env

# --- Django ---
DJANGO_SECRET=change-me
# Прод-режим: не задавать или False. Для локальной разработки — True
DJANGO_DEBUG=True
# Домены сайта через запятую (для прода обязательно!)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Источники для CSRF, напр. https://foltz.by,https://www.foltz.by
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
POSTGRES_DB_NAME=foltz
POSTGRES_DB_USER=foltz
POSTGRES_DB_PASSWORD=change-me
POSTGRES_DB_HOST=127.0.0.1
POSTGRES_DB_PORT=5432

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_SESSION=1
REDIS_DB_CACHE=2

# --- Прочее ---
LANGUAGE_CODE=ru
TIME_ZONE=Europe/Minsk
CLIENT_CACHE_MAX_AGE=86400

# --- Почта (SMTP) ---
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_SEND_FROM=example@gmail.com
EMAIL_HOST_PASSWORD=change-me

# --- Контакты сайта (шапка/футер/CTA) ---
SITE_PHONE=+375 (44) 577-00-04
SITE_EMAIL=
SITE_ADDRESS=

# --- Telegram-бот (заявки) ---
# Токен бота от @BotFather
BOT_TOKEN=
# ID группы/канала, куда падают заявки с сайта (добавьте бота в группу!)
CHAT_ID=
# ID супергруппы для заявок, раздаваемых ботом по команде /messages
SUPERGROUP_ID=
# Круг пользователей Telegram (через запятую), которым дублируются заявки.
# Если пусто — берётся ADMIN_IDS
NOTIFY_USER_IDS=
# Админы бота: доступны команды /start, /messages, ответы в группе (через запятую)
ADMIN_IDS=
# E-mail получателей копий заявок через запятую
SEND_TO_EMAIL=
# Адрес отправителя писем (обычно совпадает с EMAIL_SEND_FROM)
SEND_FROM_EMAIL=
# URL API этого сайта для бота, напр. https://foltz.by
YOUR_SITE_API_URL=
# Webhook-режим бота: не задавать или False — используется polling
USE_WEBHOOK=False
BOT_WEBHOOK=
# Доступ бота к админке сайта
SITE_ADMIN_NAME=
SITE_ADMIN_PASSWORD=